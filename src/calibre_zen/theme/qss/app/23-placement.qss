/* The picture in the plugin install dialog -- calibre_zen/placement.py. A bar or
   a short menu per ticked place, the buttons already there as icons and the new
   one in the accent. */

#zenPlacement #zenPlaceTitle, #zenPlacement #zenPlaceHint { color: $muted; }

#zenPlacement #zenPlaceBar, #zenPlacement #zenPlaceMenu {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: ${radius_row}px;
}

#zenPlacement #zenPlaceNew {
    background-color: $selected_soft;
    border: 1px solid $accent;
    border-radius: ${radius_row}px;
}
#zenPlacement #zenPlaceNewText { color: palette(window-text); font-weight: $weight_heading; }

/* A separator between two groups of buttons: a hairline, not a frame. */
#zenPlacement #zenPlaceSep { color: $border; }

/* The list of places above the picture: a tick per row (placement.tick_list), the
   chosen rows in a light wash rather than a solid block of accent, and room
   around each row. After 08-itemviews, and by id, so it wins over every
   ::item:selected rule there, focused or not. */
#zenPlaceList { padding: ${place_list_pad}px; }
#zenPlaceList::item { padding: $pad_place_row; border-radius: ${radius_row}px; }
#zenPlaceList::item:hover { background-color: $hover; }
#zenPlaceList::item:selected, #zenPlaceList::item:selected:!active {
    background-color: $pressed;
    color: palette(text);
}
